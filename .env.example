# Скопируй в .env и при необходимости поправь.

# Базы данных (Postgres из docker-compose.yml)
DATABASE_URL=postgresql+psycopg://mini:mini@localhost:5432/mini_assistant
TEST_DATABASE_URL=postgresql+psycopg://mini:mini@localhost:5432/mini_assistant_test

# LLM: OpenAI-совместимый сервер (llama-server / vLLM)
LLM_BASE_URL=http://localhost:8080/v1
LLM_MODEL=qwen2.5-1.5b-instruct
LLM_API_KEY=dummy

# Эмбеддинги: sentence-transformers или fake (для тестов)
EMBED_BACKEND=sentence-transformers
EMBED_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Параметры пайплайна
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=3
LOG_LEVEL=INFO
